# Environment Configuration Example
# 
# For Docker: Copy this to .env (database hosts use container names)
# For Local: Copy this to .env and change hosts to localhost
#
# Current .env is configured for Docker deployment

# Application
APP_NAME=ontology-knowledge-base
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=600
API_WORKERS=4

# PostgreSQL
# Docker: postgres | Local: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ontology_kb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Neo4j
# Docker: bolt://neo4j:7687 | Local: bolt://localhost:7688
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology123
NEO4J_DATABASE=neo4j

# Redis
# Docker: redis | Local: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# LLM APIs - Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_endpoint_here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
LLM_PROVIDER=azure_openai

# Security
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Processing Configuration
MAX_FILE_SIZE_MB=50
CHUNK_SIZE_WORDS=5000
CHUNK_OVERLAP_WORDS=500
BATCH_SIZE=1000
DUPLICATE_THRESHOLD=0.9
SEMANTIC_SIMILARITY_THRESHOLD=0.95

# Retry Configuration
MAX_RETRIES=3
RETRY_INITIAL_DELAY=2
RETRY_EXPONENTIAL_BASE=2

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Lock Configuration
LOCK_TIMEOUT_MINUTES=30

# Audit
AUDIT_LOG_RETENTION_DAYS=730
